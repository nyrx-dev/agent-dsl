servers:
 docs = https://mcp.context7.com/mcp
 wiki = https://mcp.deepwiki.com/mcp

workflow FrameworkResearch:
 step resolveReact = tool:docs.resolve-library-id("react hooks", "react") -> reactLib

 if reactLib.isError:
  step reportFailure = tool:wiki.ask_question("facebook/react", "What is React?") -> summary
 else:
  step namedHook = tool:wiki.ask_question("facebook/react", "Name one hook added in React 19. Reply with only its name.") -> hookName
  step explainHook = tool:wiki.ask_question("facebook/react", hookName.content[0].text) -> summary

  if hookName.content[0].type == "text":
   step reactTopics = tool:wiki.read_wiki_structure("facebook/react") -> reactStructure
  else:
   step vueTopics = tool:wiki.read_wiki_structure("vuejs/core") -> vueStructure

 step compare = tool:wiki.ask_question("vuejs/core", "How does the reactivity system track dependencies?") -> vueAnswer
